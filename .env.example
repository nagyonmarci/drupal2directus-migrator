# Drupal 10 MySQL Database
DRUPAL_DB_HOST=localhost
DRUPAL_DB_PORT=3306
DRUPAL_DB_NAME=drupal
DRUPAL_DB_USER=drupal
DRUPAL_DB_PASSWORD=secret

# Drupal site base URL (used for REST API + file downloads)
# Example: https://mysite.com  (no trailing slash)
DRUPAL_BASE_URL=https://mysite.com

# Drupal REST API credentials (user with admin or content access)
DRUPAL_API_USER=admin
DRUPAL_API_PASSWORD=admin_password

# Directus 11
DIRECTUS_URL=https://directus.mysite.com
DIRECTUS_ADMIN_TOKEN=your-static-admin-token-here
